---
import '../themes/aurora/styles/components/corner-actions.css';
import BackToTop from './BackToTop.astro';
import CornerButton from './CornerButton.astro';
import { getPluginPostActions } from '../plugins';
import type { TocItem } from '../utils/toc';
import { getTranslation, getLocale } from '../utils/i18n';

interface Props {
  toc?: TocItem[];
  postId?: string;
  post?: any;
  settings?: Record<string, any>;
  dataSource?: any;
}
const props = Astro.props as Props;
const { toc = [], postId = '', post, settings } = props;

// Plugin-owned corner actions; core only knows the registration contract.
const actionCtx = {
  post,
  postId,
  dataSource: props.dataSource,
  settings,
  toc,
};
const actions = getPluginPostActions(actionCtx);

const locale = getLocale(Astro.locals);
const t = (key: string) => getTranslation(locale, key);

const btnCount = actions.length;
const actionLabel = (action: (typeof actions)[number]) =>
  action.labelKey ? t(action.labelKey) : action.id;
const actionProps = (action: (typeof actions)[number]) =>
  typeof action.props === 'function' ? action.props(actionCtx) : (action.props || {});
---

<BackToTop />

{btnCount > 0 && (
<div class="ca-left">
  <CornerButton id="cb-left" template="menu" side="left" variant="primary" capsule={btnCount>1} capsuleWidth={btnCount * 50 + Math.max(0, btnCount - 1)}>
    <Fragment slot="buttons">
      {actions.map((action) => (
        <button
          class="cb__slot"
          data-menu={action.component ? action.id : undefined}
          data-action={action.action}
          title={actionLabel(action)}
          aria-label={actionLabel(action)}
        >
          {action.icon ? <span class="cb__icon" set:html={action.icon} /> : <span class="cb__icon">{actionLabel(action).slice(0, 1)}</span>}
        </button>
      ))}
    </Fragment>
    {actions.filter((action) => action.component).map((action) => {
      const ActionComponent = action.component;
      return (
        <div data-menu={action.id} hidden>
          <ActionComponent postId={postId} variant="inline" {...actionProps(action)} />
        </div>
      );
    })}
  </CornerButton>
</div>
)}
