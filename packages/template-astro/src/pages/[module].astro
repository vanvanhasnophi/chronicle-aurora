---
// Generic root redirect for plugin pages: /<module> → /<locale>/<module>.
// Core does not know any concrete plugin route; the dynamic page enumerates them.
import { getAllPluginPages } from '../plugins';

export const prerender = true;

export function getStaticPaths() {
  return getAllPluginPages().map((page: any) => ({ params: { module: page.route } }));
}

const { module } = Astro.params;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Redirecting…</title>
    <noscript><meta http-equiv="refresh" content={`0; url=/zh/${module}`} /></noscript>
  </head>
  <body>
    <script define:vars={{ module }}>
      (function () {
        var path = String(module || window.location.pathname.replace(/\/+$/, '').replace(/^\//, ''));
        var zh = false;
        try {
          var pref = localStorage.getItem('locale') || '';
          if (pref === 'zh-CN' || pref === 'zh') zh = true;
          else if (pref === 'en') zh = false;
          else {
            var m = document.cookie.match(/(?:^|; )locale=([^;]+)/);
            var cp = m ? m[1] : '';
            if (cp === 'zh-CN' || cp === 'zh') zh = true;
            else if (cp === 'en') zh = false;
            else zh = (navigator.language || '').toLowerCase().indexOf('zh') === 0;
          }
        } catch (e) {
          zh = (navigator.language || '').toLowerCase().indexOf('zh') === 0;
        }
        window.location.replace((zh ? '/zh/' : '/en/') + path + window.location.search + window.location.hash);
      })();
    </script>
  </body>
</html>
