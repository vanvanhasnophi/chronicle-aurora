---
import './styles/global-search-overlay.css';
import SearchExperience from "./SearchExperience.astro";

interface Props {
  locale?: string;
  routePrefix?: string;
  t?: (key: string) => string;
  searchSuggestionsEnabled?: boolean;
  fullTextSearchEnabled?: boolean;
}

const {
  locale = 'zh-CN',
  routePrefix = '/zh',
  t = (key: string) => key,
  searchSuggestionsEnabled = false,
  fullTextSearchEnabled = false,
} = Astro.props;
---

<div class="global-search-overlay" data-global-search-overlay hidden>
  <div class="global-search-backdrop" data-global-search-backdrop></div>
  <div class="global-search-panel" data-global-search-panel role="dialog" aria-modal="true" aria-label={t("nav.search")}>
    <SearchExperience
      mode="overlay"
      locale={locale}
      routePrefix={routePrefix}
      t={t}
      searchSuggestionsEnabled={searchSuggestionsEnabled}
      fullTextSearchEnabled={fullTextSearchEnabled}
      indexUrl="/posts/index.json"
      fullIndexUrl="/posts/full_index.json"
      featuredLabel={t("tag.featured")}
    />
  </div>
</div>



<script>
  let _overlayOpen = false;
  let _closeTimer: ReturnType<typeof setTimeout> | null = null;

  function getOverlay() {
    return document.querySelector('[data-global-search-overlay]') as HTMLElement | null;
  }

  // Focus the search input once it's actually mounted and renderable. The panel
  // content is re-created on ClientRouter swaps, and the `visibility` entrance
  // transition leaves the input unrenderable until the first style recalc — a
  // lone focus() call in the same task lands before either, so it's silently
  // dropped. Re-query + re-focus each frame until focus sticks (bounded).
  function focusSearchInput(overlay: HTMLElement, attempt = 0) {
    const input = overlay.querySelector('#search-input') as HTMLInputElement | null;
    if (!input) return;
    input.focus();
    if (document.activeElement !== input && attempt < 5) {
      requestAnimationFrame(() => focusSearchInput(overlay, attempt + 1));
    }
  }

  function setInitialState(detail: Record<string, unknown> = {}) {
    const overlay = getOverlay();
    if (!overlay) return;
    const keyword = typeof detail.keyword === 'string' ? detail.keyword : '';
    const tags = typeof detail.tags === 'string' ? detail.tags : '';
    const view = typeof detail.view === 'string' ? detail.view : '';
    if (keyword) overlay.dataset.searchKeyword = keyword; else delete overlay.dataset.searchKeyword;
    if (tags) overlay.dataset.searchTags = tags; else delete overlay.dataset.searchTags;
    if (view) overlay.dataset.searchView = view; else delete overlay.dataset.searchView;
  }

  function open(detail: Record<string, unknown> = {}) {
    const overlay = getOverlay();
    if (!overlay) return;
    setInitialState(detail);
    if (_overlayOpen) {
      // Already open: apply the new query/tags in place.
      document.dispatchEvent(new CustomEvent('chronicle:search-apply', { detail }));
      return;
    }
    _overlayOpen = true;
    if (_closeTimer) { clearTimeout(_closeTimer); _closeTimer = null; }
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    // Commit the closed state, then transition in on the next style flush.
    void overlay.offsetWidth;
    overlay.classList.add('is-open');
    focusSearchInput(overlay);
    document.dispatchEvent(new CustomEvent('chronicle:global-search-open'));
    // The engine may initialize after this event; it also reads the dataset
    // attributes when its prime() completes.
    document.dispatchEvent(new CustomEvent('chronicle:search-apply', { detail }));
  }

  function close() {
    const overlay = getOverlay();
    if (!overlay) return;
    if (!_overlayOpen) return;
    _overlayOpen = false;
    document.body.style.overflow = '';
    overlay.classList.remove('is-open');
    if (_closeTimer) clearTimeout(_closeTimer);
    _closeTimer = setTimeout(() => {
      _closeTimer = null;
      overlay.hidden = true;
    }, 210); // slightly longer than the 0.2s exit transition
    document.dispatchEvent(new CustomEvent('chronicle:global-search-close'));
  }

  function isTyping() {
    const el = document.activeElement as HTMLElement | null;
    if (!el) return false;
    const tag = (el.tagName || '').toLowerCase();
    return tag === 'input' || tag === 'textarea' || el.isContentEditable;
  }

  // Delegated to document so the triggers survive ClientRouter soft navigations.
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      open();
      return;
    }
    if (e.key === '/' && !isTyping()) {
      e.preventDefault();
      open();
      return;
    }
    if (e.key === 'Escape' && _overlayOpen) {
      e.preventDefault();
      close();
    }
  });

  document.addEventListener('chronicle:open-search', (event) => {
    open((event as CustomEvent).detail || {});
  });

  function searchRouteParams(anchor: HTMLAnchorElement): Record<string, string> | null {
    try {
      const url = new URL(anchor.href, location.origin);
      if (url.origin !== location.origin) return null;
      const path = url.pathname.replace(/\/+$/, '');
      if (path !== '/search' && path !== '/zh/search' && path !== '/en/search') return null;
      return {
        keyword: url.searchParams.get('keyword') || '',
        tags: url.searchParams.get('tags') || '',
        view: url.searchParams.get('view') || '',
      };
    } catch {
      return null;
    }
  }

  // Capture phase — runs before Astro's ClientRouter click handler, so the
  // anchor default / soft navigation is suppressed and the overlay opens instead.
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const trigger = target && target.closest ? target.closest('[data-global-search]') : null;
    if (trigger) {
      e.preventDefault();
      e.stopPropagation();
      open({
        keyword: trigger.getAttribute('data-search-keyword') || '',
        tags: trigger.getAttribute('data-search-tags') || '',
        view: trigger.getAttribute('data-search-view') || '',
      });
      return;
    }
    // Blog card tags are spans inside the card's post link; open tag search
    // without navigating to the post.
    const cardTag = target && target.closest ? target.closest('.post-tags .tag') as HTMLElement | null : null;
    if (cardTag) {
      e.preventDefault();
      e.stopPropagation();
      let tagName = cardTag.textContent || '';
      tagName = tagName.replace(/^#\s*/, '').trim();
      if (tagName === '精选' || tagName === 'Featured') tagName = 'featured';
      if (tagName) open({ tags: tagName });
      return;
    }
    const anchor = target && target.closest ? target.closest('a[href]') as HTMLAnchorElement | null : null;
    if (anchor && !e.defaultPrevented && !e.ctrlKey && !e.metaKey && !e.shiftKey && !e.altKey) {
      const params = searchRouteParams(anchor);
      if (params) {
        e.preventDefault();
        e.stopPropagation();
        open(params);
        return;
      }
    }
    const backdrop = target && target.closest ? target.closest('[data-global-search-backdrop]') : null;
    if (backdrop) {
      close();
      return;
    }
    // Blank area of the panel (transparent padding / empty space around the
    // search box and content) dismisses the overlay too — but clicks on the
    // search box or content stay interactive.
    const panel = target?.closest('[data-global-search-panel]');
    if (panel) {
      const interactive = target?.closest('.search-box-wrapper, .content-wrapper');
      if (!interactive) close();
    }
  }, true);

  // Consume query handed off by the /search route's head redirect.
  try {
    const raw = sessionStorage.getItem('chronicle:search-pending');
    if (raw) {
      sessionStorage.removeItem('chronicle:search-pending');
      const detail = JSON.parse(raw) as Record<string, string>;
      open({
        keyword: detail.keyword || '',
        tags: detail.tags || '',
        view: detail.view || '',
      });
    }
  } catch { /* ignore pending state */ }

  // Overlay is transient — close it on soft navigation (no persist).
  document.addEventListener('astro:after-swap', () => {
    _overlayOpen = false;
    if (_closeTimer) { clearTimeout(_closeTimer); _closeTimer = null; }
    document.body.style.overflow = '';
  });
</script>
