---
// ── search 插件页面体：/search（主板壳渲染本插件页面体）──────────
// 主板路由壳（pages/[lang]/search.astro）负责路由；本组件自含 Layout 包裹与数据读取。
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import searchCritical from "./styles/critical.css?raw";
import SearchExperience from "./SearchExperience.astro";
import { getTranslation, getLocale } from "../../utils/i18n";
import { resolveFeatureFlags } from "../../utils/featureFlags";
import { loadSiteSettings } from "../../utils/siteSettings";

const locale = getLocale(Astro.locals);
const t = (key: string) => getTranslation(locale, key);
const routePrefix = locale === "zh-CN" ? "/zh" : "/en";

const settings = await loadSiteSettings();

const featureFlags = resolveFeatureFlags(settings?.featureFlags);
const searchSuggestionsEnabled = featureFlags.searchSuggestions !== false;
const fullTextSearchEnabled = featureFlags.fullTextSearch === true;
const globalSearchEnabled = featureFlags.globalSearch === true;
const homePath = locale === "zh-CN" ? "/zh/" : "/en/";

const metaDescription = locale === "zh-CN"
  ? "在 Chronicle 中按标题或标签搜索文章与内容。"
  : "Search Chronicle posts and content by title or tags.";
---

<Layout title={t("nav.search")} settings={settings} scrollable={false} meta={{ description: metaDescription }}>
  <Fragment slot="head">
    <style is:inline set:html={searchCritical} />
    {globalSearchEnabled && <meta http-equiv="refresh" content={`0;url=${homePath}`} />}
    {globalSearchEnabled && (
      <script is:inline define:vars={{ homePath }}>
        (function () {
          const params = new URLSearchParams(location.search);
          const detail = {
            keyword: params.get('keyword') || '',
            tags: params.get('tags') || '',
            view: params.get('view') || '',
          };
          try {
            // Even an empty query opens the overlay once on the home page.
            sessionStorage.setItem('chronicle:search-pending', JSON.stringify(detail));
          } catch {}
          location.replace(homePath);
        })();
      </script>
    )}
  </Fragment>
  {globalSearchEnabled ? (
    <div class="search-page-overlay-host" aria-hidden="true"></div>
  ) : (
    <SearchExperience
      mode="page"
      locale={locale}
      routePrefix={routePrefix}
      t={t}
      searchSuggestionsEnabled={searchSuggestionsEnabled}
      fullTextSearchEnabled={fullTextSearchEnabled}
      indexUrl="/posts/index.json"
      fullIndexUrl="/posts/full_index.json"
      featuredLabel={t("tag.featured")}
    />
  )}
</Layout>
