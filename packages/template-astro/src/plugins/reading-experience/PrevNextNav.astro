---
import './styles/prevnext-nav.css';
import { dataSource } from '../../data';
import { getPostExtension } from '../../data/extensions';
import { getTranslation, type Locale } from '../../utils/i18n';
import { hasCapability, isPostTypeQueueIgnored } from '../../plugins';

interface Props {
  post: any;
  locale: Locale;
  lang: string;
  mode?: 'both' | 'next-only';
  scope?: 'global' | 'collection';
  /** 全部拉通（global）时的日期排序方向：desc=第一篇最新（默认），asc=第一篇最老。 */
  order?: 'asc' | 'desc';
}
const { post, locale, lang, mode = 'both', scope = 'global', order = 'desc' } = Astro.props as Props;
const t = (key: string) => getTranslation(locale, key);

// ── 规则 1：导航忽略 queueIgnored 类型（如 slides 无正文阅读顺序）——
// 由插件 postTypes.queueIgnored 声明（默认 false）；当前页或候选是该类型
// 都不参与 prev/next。core 不预知具体类型名。
const isPostIgnored = isPostTypeQueueIgnored(post?.type || 'article');
if (isPostIgnored) return;
const published = (dataSource.getPublishedPosts() as any[]).filter(
  (p: any) => !isPostTypeQueueIgnored(p.type || 'article'),
);

// collection scope is only valid while the collections capability / nav slot is
// present. Without it, fall back to global order so a disabled plugin leaves no
// collection-specific navigation behind.
const collectionCapable = hasCapability('getCollections');
const effectiveScope = scope === 'collection' && !collectionCapable ? 'global' : scope;
const collectionName = String(getPostExtension<any>(post, 'collections')?.name || '');

// ── 规则 2：collection 内导航开启时，不属于任何 collection 的文章不显示 prev/next ──
if (effectiveScope === 'collection' && !collectionName) return;

// ── collection scope：按 collections.yml nodes 顺序导航（collection 自带顺序，不受 order 影响）──
let prev: any = null;
let next: any = null;
if (effectiveScope === 'collection') {
  const seq = (dataSource.getCollectionPostIds?.(collectionName) || [])
    .map((id) => published.find((p: any) => String(p.id) === id))
    .filter(Boolean);
  if (seq.length === 0) return;
  const pos = seq.findIndex((p: any) => String(p.id) === String(post.id));
  if (pos === -1) return;
  prev = pos > 0 ? seq[pos - 1] : null;
  next = pos < seq.length - 1 ? seq[pos + 1] : null;
} else {
  // ── global scope：全部拉通，按日期 + prevNextOrder 方向排序 ──
  const pool = published.filter((p: any) => String(p.id) !== String(post.id));
  if (pool.length === 0) return;
  const desc = order !== 'asc';
  const sorted = [...pool].sort((a: any, b: any) => {
    const cmp = String(a.date) < String(b.date) ? -1 : 1;
    return desc ? -cmp : cmp;
  });
  // desc：第一个日期比当前早的 = 下一篇；asc：第一个日期比当前晚的 = 下一篇；-1 → 当前即末尾
  const myPos = sorted.findIndex((p: any) =>
    desc ? String(p.date) < String(post.date) : String(p.date) > String(post.date),
  );
  prev = myPos === -1
    ? (sorted.length ? sorted[sorted.length - 1] : null)
    : (myPos > 0 ? sorted[myPos - 1] : null);
  next = myPos >= 0 ? sorted[myPos] : null;
}

// ── 规则 3：next-only 模式完全去掉 prev 侧（链接与占位都不渲染）──
const nextOnly = mode === 'next-only';
const showPrev = nextOnly ? null : prev;
const showNext = next ? next : null;
// ── 规则 4：最后一篇（无 next）仍显示「已是最后一篇」占位，nav 不整块消失 ──
// next-only：恒渲染单列 next 侧（有 next → 链接，无 → 占位）；both：任一侧有内容才渲染
const renderNav = nextOnly ? true : (!!showPrev || !!showNext);
---

{renderNav && (
  <nav class:list={['prevnext-nav', nextOnly ? 'prevnext-nav--next-only' : '']}>
    {!nextOnly && (
      showPrev ? (
        <a class="pn-card mtl-surface interactive glowable pn-prev" href={`/${lang}/post/${encodeURIComponent(showPrev.id)}`}>
          <span class="pn-label">{t('postPage.prevPost')}</span>
          <span class="pn-title">{showPrev.title}</span>
        </a>
      ) : (
        // 缺失侧占位符：说明性文字（已经是第一篇），保持网格布局稳定
        <span class="pn-card pn-placeholder pn-placeholder--prev">
          <span class="pn-placeholder-label">{t('postPage.noPrev')}</span>
        </span>
      )
    )}
    {showNext ? (
      <a class="pn-card mtl-surface interactive glowable pn-next" href={`/${lang}/post/${encodeURIComponent(showNext.id)}`}>
        <span class="pn-label">{t('postPage.nextPost')}</span>
        <span class="pn-title">{showNext.title}</span>
      </a>
    ) : (
      // 缺失侧占位符：说明性文字（已经是最后一篇）
      <span class="pn-card pn-placeholder pn-placeholder--next">
        <span class="pn-placeholder-label">{t('postPage.noNext')}</span>
      </span>
    )}
  </nav>
)}


